    <javaClientGenerator type="XMLMAPPER" targetPackage="jp.co.aquaclara.accis.common.domain.repository.dao" targetProject="accisCommon/src/main/java">
      <!-- "enableSubPackages"は、後でドメインごとにパッケージを分ける時に使用されます。 -->
      <!-- <property name="enableSubPackages" value="true" /> -->
    </javaClientGenerator>

