<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE generatorConfiguration PUBLIC "-//mybatis.org//DTD MyBatis Generator Configuration 1.0//EN" "http://mybatis.org/dtd/mybatis-generator-config_1_0.dtd">
<generatorConfiguration>

  <!-- {defaultModelType}について、Entityクラスはテーブル毎に1個ずつに自動生成したいが、そのために"flat"を指定すると
    Dao.javaでSelect文の引数がEntityではなくて、個別項目(String shopCdなど)を引数としてもらう構成に自動生成される問題があります。
    なので、仕方なくEntityKeyまで生成する"hierarchical"を設定しています。
    "conditional"だと、あるテーブルはEntityクラスが2つ、あるテーブルはEntityクラスが1つになるなど、一貫性がなくなります。
    
    "flat": このモデルは、任意のテーブルに対して1つのドメインクラスのみを生成します。クラスは、テーブル内のすべてのフィールドを保持します。
    "conditional"[default]: このモデルは"hierarchical"モデルに似ていますが、EntityKeyクラスなどの別のクラスにフィールドが1つしかない場合、その別のクラスは生成されません。
    "hierarchical": テーブルに主キーがある場合、主キークラス、テーブル内のBLOB列を保持する別のクラス、および残りのフィールドを保持する別のクラスを生成します。
  -->
  <context id="local" targetRuntime="MyBatis3" defaultModelType="hierarchical">


    <!-- DB接続時に必要な情報(ID,Passwordなど)や、Entity, Daoファイルの保存先が
      現在このconfigファイルにべた書きになっているので、プロパティーファイルとして分離する必要があると思います。[※環境毎に切り替える必要があれば] -->


    <!-- この文字コード設定がないと、Mybatis Generatorの自動コメント作成機能の利用時に、コメントが文字化けするため、追加しました。 -->
    <property name="javaFileEncoding" value="UTF-8"/>
    
    <!-- *Entity.javaでLombokを使用するためのプラグイン -->
    <plugin type="com.softwareloop.mybatis.generator.plugins.LombokPlugin">
    <!-- hasLombokをtrueにしないと、Entityクラス自動生成時にgetterとsetterメソッドが作成されます。(@Getter,@Setterアノテーションを付ける設定をONにしてもGet,Setメソッドが作成されます。)
      このhasLombokの設定だけでも、現在必要なアノテーションは全部自動的に付けてくれている認識です。(※他に必要なアノテーションはないか確認したいです。) -->
      <property name="hasLombok" value="true"/>
<!--  <property name="@Builder" value="false" />
      <property name="@AllArgsConstructor" value="true" />
      <property name="@NoArgsConstructor" value="true" />
      <property name="@Accessors(chain = true)" value="false" />
      <property name="supportSuperBuilderForIdea" value="false" />
      <property name="@Data" value="true" /> -->
    </plugin>

    <!-- EntityクラスにtoStringメソッドを生成するプラグイン -->
    <plugin type="org.mybatis.generator.plugins.ToStringPlugin" />

    <!-- *Dao.javaのアノテーションを制御するためのプラグイン -->
    <plugin type="org.mybatis.generator.plugins.MapperAnnotationPlugin">
      <!-- @Mapper以外にも必要なアノテーションがあれば、調査します。 -->
      <property name="@Mapper" value="true"/>
      <property name="@Repository" value="false"/>
    </plugin>
   
    <!-- RowBoundsプラグインは、org.apache.ibatis.session.RowBoundsクラスにlimit、offsetを指定することで、
      検索結果のうち、特定の範囲を取り出すことができます。-->
    <plugin type="org.mybatis.generator.plugins.RowBoundsPlugin" />
   
    <!-- Serializableプラグインは、モデルクラスにSerializableインターフェースを追加します。 -->
    <plugin type="org.mybatis.generator.plugins.SerializablePlugin" />
    
    <!-- コメントの自動生成:項目の論理名をコメントとして生成してくれる。
      生成される Java ファイルのコメントにカラムや自動生成した日付情報を付与する/しない 
      true: 付与しない / false: 付与する  -->
    <commentGenerator>
      <!-- "suppressAllComments"が、trueになっているとコメント自体が生成されなくなるので、他のプロパティー設定は自動的に無効となります。 -->      
      <property name="suppressAllComments" value="false"/>
      
      <!-- コメントに自動生成した日付情報を付与する -->
      <property name="suppressDate" value="true" />
      
      <!-- テーブル上、各カラムの"comment"を読み込んで、コメントに追加する [※カラムの論理名を自動生成することに利用可能] -->
      <property name="addRemarkComments" value="true" />
    </commentGenerator>
   
    <!-- スキーマ情報を取得する DB への接続設定 -->
    <jdbcConnection driverClass="oracle.jdbc.driver.OracleDriver"
      connectionURL="jdbc:oracle:thin:@accis2023-stg-rds.cniy2noj9v81.ap-northeast-1.rds.amazonaws.com:1521:ORCL"
      userId="EDU"
      password="EDU">
      <!-- mysqlの場合はDBのcatalog機能がないそうで、詳細までは知りませんが、公式サイトに必要だと書いてあったため、追加しました。 -->
      <property name="nullCatalogMeansCurrent" value="true"/>
      <property name="remarksReporting" value="true"/>
    </jdbcConnection>
    
    <!-- DBカラムをjavaのタイプに合わせて変換する時に効く設定です。 -->
    <javaTypeResolver>
      <!-- "useJSR310Types"は、DBの日付タイプをjava8のDateTime型に変換してくれます。 -->
      <property name="useJSR310Types" value="true" />
      <!-- "forceBigDecimals"は、DBの数字型をすべてBigDecimalに統一するか、整数部と小数部の桁数に応じてShort,Interger,Long,Bigdecimalに変換するかの設定です。 -->
      <!-- Short型は要らない認識ですが、個別で設定はできないみたいでこのまま[整数部と小数部の桁数に応じてShort,Interger,Long,Bigdecimalに変換]にしています。 -->
      <property name="forceBigDecimals" value="false" />
    </javaTypeResolver>
    
    <!-- *Entity.java -->
    <!-- *Example.java -->
    <javaModelGenerator targetPackage="jp.co.aquaclara.accis.common.domain.repository.entity" targetProject="accisCommon/src/main/java">
      <property name="exampleTargetPackage" value="jp.co.aquaclara.accis.common.domain.repository.entity" />
      
      <!-- "enableSubPackages"は、後でドメインごとにパッケージを分ける時に使用されます。 -->
      <!-- <property name="enableSubPackages" value="true" /> -->
    </javaModelGenerator>

    <!-- *Dao.xml -->
    <!-- 特に必要なプロパティー設定はない認識です。 -->
    <sqlMapGenerator targetPackage="jp.co.aquaclara.accis.common.domain.repository.dao" targetProject="accisCommon/src/main/resources">
      <!-- "enableSubPackages"は、後でドメインごとにパッケージを分ける時に使用されます。 -->
      <!-- <property name="enableSubPackages" value="true" /> -->
    </sqlMapGenerator>
    
    <!-- *Dao.java -->
